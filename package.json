{
  "name": "auto-tab-groups",
  "version": "0.1.5",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "i18n:build": "node scripts/build-locales.mjs",
    "prebuild": "npm run i18n:build",
    "prezip": "npm run i18n:build",
    "predev": "npm run i18n:build",
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock:server": "node scripts/mock-server.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "i18next": "^26.5.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.1.9",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.1.0",
    "eslint": "^9.0.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.58.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0",
    "wxt": "^0.20.0"
  }
}
